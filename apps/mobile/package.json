{
	"name": "mobile",
	"version": "0.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"start:local": "APP_VARIANT=development EXPO_PUBLIC_APP_SCHEME=zuse-dev expo start --dev-client",
		"ios": "expo run:ios",
		"ios:local": "APP_VARIANT=development EXPO_PUBLIC_APP_SCHEME=zuse-dev expo run:ios --configuration Debug",
		"build:ios:testflight": "eas build --platform ios --profile testflight --auto-submit",
		"build:ios:production": "eas build --platform ios --profile production --auto-submit",
		"lint": "eslint .",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run test",
		"test:unit": "vitest run test/unit",
		"test:integration": "vitest run test/integration --passWithNoTests",
		"android": "expo run:android",
		"android:local": "APP_VARIANT=development EXPO_PUBLIC_APP_SCHEME=zuse-dev expo run:android --variant debug",
		"gen:file-icons": "node scripts/gen-file-icons.mjs",
		"eas-build-on-success": "if [ \"$EAS_BUILD_PROFILE\" = \"store-screenshots\" ]; then bash scripts/capture-store-screenshots.sh; fi"
	},
	"expo": {
		"install": {
			"exclude": [
				"typescript",
				"@types/react"
			]
		},
		"doctor": {
			"appConfigFieldsNotSyncedCheck": {
				"enabled": false
			}
		}
	},
	"dependencies": {
		"@effect/atom-react": "4.0.0-beta.102",
		"@expo-google-fonts/geist-mono": "^0.4.1",
		"@expo-google-fonts/inter": "^0.4.2",
		"@expo/metro-runtime": "~58.0.15",
		"@expo/ui": "~58.0.23",
		"@hugeicons/react-native": "^1.0.15",
		"@legendapp/list": "3.3.3",
		"@noble/ciphers": "^1.3.0",
		"@noble/curves": "^1.9.7",
		"@noble/hashes": "^1.8.0",
		"@zuse/analytics": "workspace:*",
		"@zuse/client-runtime": "*",
		"@zuse/contracts": "*",
		"@zuse/i18n": "workspace:*",
		"@zuse/icons": "workspace:*",
		"@zuse/utils": "*",
		"clsx": "^2.1.1",
		"effect": "catalog:",
		"expo": "~58.0.19",
		"expo-application": "~58.1.2",
		"expo-asset": "~58.0.18",
		"expo-audio": "~58.0.10",
		"expo-auth-session": "~58.0.14",
		"expo-camera": "~58.0.12",
		"expo-clipboard": "~58.0.4",
		"expo-constants": "~58.0.13",
		"expo-crypto": "~58.0.7",
		"expo-dev-client": "~58.0.15",
		"expo-document-picker": "~58.0.4",
		"expo-file-system": "~58.0.11",
		"expo-font": "~58.0.10",
		"expo-glass-effect": "~58.0.5",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.17",
		"expo-image-picker": "~58.0.10",
		"expo-linking": "~58.0.14",
		"expo-localization": "~58.0.5",
		"expo-notifications": "~58.1.6",
		"expo-router": "~58.0.26",
		"expo-screen-orientation": "~58.0.3",
		"expo-secure-store": "~58.0.2",
		"expo-status-bar": "~58.0.4",
		"expo-symbols": "~58.0.4",
		"expo-system-ui": "~58.0.6",
		"expo-web-browser": "~58.0.6",
		"jose": "^6.2.3",
		"lucide-react-native": "^0.475.0",
		"mermaid": "11.15.0",
		"posthog-react-native": "^4.58.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-markdown-display": "^7.0.2",
		"react-native-quick-crypto": "^0.7.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-web": "^0.21.4",
		"react-native-webview": "14.0.1",
		"react-native-worklets": "0.13.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.0.0",
		"text-encoding": "^0.7.0",
		"uniwind": "^1.13.0"
	},
	"devDependencies": {
		"@pierre/trees": "1.0.0-beta.5",
		"@repo/typescript-config": "*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@zuse/testkit": "*",
		"babel-preset-expo": "~58.0.0",
		"eslint": "catalog:",
		"eslint-config-expo": "~58.0.4",
		"sharp": "^0.34.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
