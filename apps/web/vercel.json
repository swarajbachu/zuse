{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"git": {
		"deploymentEnabled": {
			"**": false,
			"main": true
		}
	},
	"ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
	"redirects": [
		{
			"source": "/",
			"has": [
				{
					"type": "host",
					"value": "zuse.sh"
				}
			],
			"destination": "https://www.zuse.sh/",
			"permanent": true
		},
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "zuse.sh"
				}
			],
			"destination": "https://www.zuse.sh/:path*",
			"permanent": true
		}
	]
}
