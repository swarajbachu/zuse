---
import { getCollection } from "astro:content";
import { ArrowRight } from "lucide-react";
import { SearchDialog, type SearchItem } from "../components/SearchDialog";
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNavigation } from "../lib/navigation";
import { SECTION_LABELS, SITE } from "../lib/site";

const navigation = getNavigation();
const content = await getCollection("docs");
const searchItems: SearchItem[] = content.map((entry) => ({
	title: entry.data.title,
	description: entry.data.description,
	url: `/${entry.id.replace(/\.(md|mdx)$/u, "").replace(/\/index$/u, "")}`,
	section: SECTION_LABELS[entry.data.section] ?? entry.data.section,
}));
const paths = [
	{ eyebrow: "Desktop", title: "Run your first coding agent", description: "Install Zuse, connect a provider, open a repository, and finish a first change.", href: "/start/first-chat", number: "01" },
	{ eyebrow: "Remote", title: "Control your computer from anywhere", description: "Understand local pairing, hosted access, mobile clients, and the security boundary.", href: "/remote", number: "02" },
	{ eyebrow: "Serve", title: "Turn a Mac or Linux box into a host", description: "Install the durable runtime, link the computer, and operate it with the Serve CLI.", href: "/serve", number: "03" },
];
---

<BaseLayout>
	<header class="home-topbar">
		<a class="brand" href="/" aria-label="Zuse Docs home"><span class="brand-mark">Z</span><span class="brand-name">Zuse</span><span class="brand-divider"></span><span class="brand-docs">Docs</span></a>
		<div class="home-topbar-center"><SearchDialog items={searchItems} client:load /></div>
		<nav class="home-topbar-actions" aria-label="Site navigation">
			<a href={SITE.githubUrl} aria-label="Zuse on GitHub"><svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 6 3 12l5 6M16 6l5 6-5 6M14 4l-4 16" /></svg></a>
			<ThemeToggle />
			<a class="topbar-cta" href={SITE.downloadUrl}>Download</a>
		</nav>
	</header>

	<main id="main-content" class="docs-home">
		<section class="home-hero">
			<div class="home-hero-copy">
				<a class="release-pill" href={`${SITE.productUrl}/changelog`}><span></span>Latest documentation · v0.16</a>
				<p class="home-kicker">One workspace. Every coding agent.</p>
				<h1>Build locally.<br /><em>Stay in control</em> everywhere.</h1>
				<p class="home-lede">The complete guide to Zuse desktop, mobile, remote access, and the Serve runtime—written around real workflows, not feature lists.</p>
				<div class="home-actions"><a class="button-primary" href="/start/first-chat">Start with Zuse <ArrowRight aria-hidden="true" size={16} /></a><a class="button-secondary" href="/concepts">How Zuse works</a></div>
			</div>
			<div class="product-stage" role="img" aria-label="Zuse workspace showing projects, an agent conversation, and files">
				<div class="stage-top"><span class="stage-traffic"><i></i><i></i><i></i></span><span>zuse / forkzero</span><span class="stage-status">Remote ready</span></div>
				<div class="stage-body">
					<div class="stage-projects"><strong>Projects</strong><span class="stage-project-active">◆ Zuse</span><span>New chat</span><span>Docs foundation</span><span>Serve reliability</span></div>
					<div class="stage-chat"><div class="stage-message-user">Document every shipped workflow.</div><div class="stage-agent"><span class="stage-agent-mark">Z</span><div><strong>Working across the product surface</strong><p>I’m grounding each guide in current behavior, then linking every recovery path back to the workflow that needs it.</p><div class="stage-tools"><span>Read 42 files</span><span>3 agents</span><span>Checks running</span></div></div></div><div class="stage-composer">Ask Zuse to make a change…<span>Send</span></div></div>
					<div class="stage-files"><strong>Workspace</strong><span>Files</span><span>Changes <b>12</b></span><span>Terminal</span><div class="stage-tree"><i></i> apps<br /><i></i> packages<br /><i></i> docs<br /><i></i> README.md</div></div>
				</div>
			</div>
		</section>

		<section class="workflow-paths" aria-labelledby="choose-path">
			<div class="section-heading"><p>Choose a path</p><h2 id="choose-path">Get to a useful result quickly.</h2></div>
			<div class="path-grid">{paths.map((path) => <a class="path-card" href={path.href}><span class="path-number">{path.number}</span><div><p>{path.eyebrow}</p><h3>{path.title}</h3><span>{path.description}</span></div><ArrowRight className="path-arrow" aria-hidden="true" size={18} /></a>)}</div>
		</section>

		<section class="docs-index" aria-labelledby="browse-docs">
			<div class="section-heading"><p>Documentation map</p><h2 id="browse-docs">Everything has a place.</h2><span>Browse by task, then follow prerequisites and next steps without losing the thread.</span></div>
			<div class="docs-index-grid">{navigation.map((group, index) => <section class="index-card"><span class="index-card-number">{String(index + 1).padStart(2, "0")}</span><h3>{group.title}</h3><ul>{group.items.slice(0, 5).map((item) => <li><a href={item.url}>{item.title}<ArrowRight aria-hidden="true" size={13} /></a></li>)}</ul>{group.items.length > 5 ? <a class="index-more" href={group.items[0]?.url}>Explore section</a> : null}</section>)}</div>
		</section>

		<section class="home-footer-cta">
			<div><p>Start here</p><h2>Your first useful Zuse session takes minutes.</h2></div><a class="button-primary" href="/start/first-chat">Open the quickstart <ArrowRight aria-hidden="true" size={16} /></a>
		</section>
	</main>
	<footer class="home-footer"><span>© 2026 Zuse</span><nav><a href={SITE.productUrl}>Product</a><a href={`${SITE.productUrl}/changelog`}>Changelog</a><a href={`${SITE.productUrl}/privacy`}>Privacy</a></nav></footer>
</BaseLayout>
