---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The requested Zuse documentation page does not exist.">
	<main class="error-page" id="main-content">
		<span>404</span>
		<h1>This page moved or never existed.</h1>
		<p>Search the documentation or return to the start page.</p>
		<div><a class="button-primary" href="/">Open documentation</a><a class="button-secondary" href="/start/first-chat">Start with your first chat</a></div>
	</main>
</BaseLayout>
