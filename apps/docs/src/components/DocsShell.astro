---
import { getCollection } from "astro:content";
import type { TOCItemType } from "fumadocs-core/toc";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAdjacentPages, getNavigation } from "../lib/navigation";
import { SECTION_LABELS, SITE } from "../lib/site";
import { SearchDialog, type SearchItem } from "./SearchDialog";
import SectionIcon from "./SectionIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	title: string;
	description: string;
	pathname: string;
	section: string;
	platforms?: ReadonlyArray<string>;
	providers?: ReadonlyArray<string>;
	lastVerified: string;
	toc: ReadonlyArray<TOCItemType>;
}

const {
	title,
	description,
	pathname,
	section,
	platforms = [],
	providers = [],
	lastVerified,
	toc,
} = Astro.props;
const navigation = getNavigation();
const adjacent = getAdjacentPages(pathname);
const content = await getCollection("docs");
const searchItems: SearchItem[] = content.map((entry) => ({
	title: entry.data.title,
	description: entry.data.description,
	url: `/${entry.id.replace(/\.(md|mdx)$/u, "").replace(/\/index$/u, "")}`,
	section: SECTION_LABELS[entry.data.section] ?? entry.data.section,
}));
---

<BaseLayout title={title} description={description} canonicalPath={pathname} image={`/og${pathname}.png`}>
	<header class="topbar">
		<a class="brand" href="/start" aria-label="Zuse documentation">
			<img class="brand-mark" src="/favicon.svg" width="26" height="26" alt="" />
			<span class="brand-name">Zuse</span>
			<span class="brand-docs">Docs</span>
		</a>
		<div class="topbar-search"><SearchDialog items={searchItems} client:load /></div>
		<nav class="topbar-actions" aria-label="Site navigation">
			<a class="icon-button" href={SITE.githubUrl} aria-label="View Zuse on GitHub">
				<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.3 3.5 6.5 6.8 6.9A4.8 4.8 0 0 0 8 18v4"></path><path d="M8 19c-3 .9-3-1.5-4-2"></path></svg>
			</a>
			<ThemeToggle />
			<a class="open-app" href={SITE.downloadUrl}>Open Zuse</a>
			<button class="mobile-nav-trigger icon-button" type="button" aria-label="Open documentation navigation" aria-controls="mobile-navigation">
				<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 7h14M5 12h14M5 17h14"></path></svg>
			</button>
		</nav>
	</header>

	<div class="docs-grid">
		<aside class="sidebar" aria-label="Documentation navigation">
			<div class="sidebar-scroll">
				{navigation.map((group) => (
					<section class="nav-group">
						<div class="nav-group-heading"><SectionIcon section={group.id} /><h2>{group.title}</h2></div>
						<ul>
							{group.items.map((item) => (
								<li><a href={item.url} aria-current={item.url === pathname ? "page" : undefined}>
									{item.url === pathname ? <span class="nav-active-indicator" aria-hidden="true"></span> : null}
									<span>{item.title}</span>
								</a></li>
							))}
						</ul>
					</section>
				))}
			</div>
		</aside>

		<main id="main-content" class="article-frame">
			<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/start">Docs</a><span>/</span><span>{SECTION_LABELS[section] ?? section}</span></nav>
			<header class="article-header">
				<h1>{title}</h1>
				<p class="article-description">{description}</p>
				{platforms.length + providers.length > 0 ? <div class="article-meta">
					{platforms.map((platform) => <span class="meta-chip">{platform}</span>)}
					{providers.map((provider) => <span class="meta-chip meta-chip-provider">{provider}</span>)}
				</div> : null}
			</header>
			{toc.length > 1 ? <details class="mobile-outline"><summary>On this page</summary><ul>{toc.map((item) => <li data-depth={item.depth}><a href={item.url}>{item.title}</a></li>)}</ul></details> : null}
			<article class="docs-prose"><slot /></article>
			<footer class="article-footer">
				<div class="verified">Verified against <strong>{lastVerified}</strong></div>
				<nav class="pagination" aria-label="Adjacent documentation">
					{adjacent.previous ? <a class="pagination-link" href={adjacent.previous.url}><span>Previous</span><strong>{adjacent.previous.title}</strong></a> : <span />}
					{adjacent.next ? <a class="pagination-link pagination-next" href={adjacent.next.url}><span>Next</span><strong>{adjacent.next.title}</strong></a> : null}
				</nav>
			</footer>
		</main>

		<aside class="context-rail" aria-label="Page context">
			<div class="context-rail-sticky">
				{toc.length > 1 ? <nav class="page-outline" aria-label="On this page"><h2>On this page</h2><ul>{toc.map((item) => <li data-depth={item.depth}><a href={item.url}>{item.title}</a></li>)}</ul></nav> : null}
				<div class="page-actions">
					<button type="button" data-copy-page={`${pathname}.md`}>Copy as Markdown</button>
					<a href={`${pathname}.md`}>Open Markdown</a>
					<a href={`${SITE.githubUrl}/issues/new`}>Report a problem</a>
				</div>
			</div>
		</aside>
	</div>

	<dialog id="mobile-navigation" class="mobile-navigation">
		<div class="mobile-navigation-head"><a class="brand" href="/start"><img class="brand-mark" src="/favicon.svg" width="26" height="26" alt="" /><span>Docs</span></a><button class="icon-button mobile-nav-close" type="button" aria-label="Close documentation navigation">×</button></div>
		<button class="mobile-navigation-search" type="button" data-mobile-search><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 4 4"></path></svg><span>Search documentation</span><kbd>⌘K</kbd></button>
		<nav aria-label="Mobile documentation navigation">
			{navigation.map((group) => <section class="nav-group"><div class="nav-group-heading"><SectionIcon section={group.id} /><h2>{group.title}</h2></div><ul>{group.items.map((item) => <li><a href={item.url} aria-current={item.url === pathname ? "page" : undefined}>{item.url === pathname ? <span class="nav-active-indicator" aria-hidden="true"></span> : null}<span>{item.title}</span></a></li>)}</ul></section>)}
		</nav>
	</dialog>

	<script>
		const dialog = document.querySelector<HTMLDialogElement>("#mobile-navigation");
		document.querySelector(".mobile-nav-trigger")?.addEventListener("click", () => dialog?.showModal());
		document.querySelector(".mobile-nav-close")?.addEventListener("click", () => dialog?.close());
		dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
		document.querySelector("[data-mobile-search]")?.addEventListener("click", () => { dialog?.close(); document.querySelector<HTMLButtonElement>(".topbar .search-trigger")?.click(); });

		const copyText = async (value: string, button: HTMLButtonElement) => {
			await navigator.clipboard.writeText(value);
			const original = button.textContent;
			button.textContent = "Copied";
			window.setTimeout(() => { button.textContent = original; }, 1500);
		};
		document.querySelectorAll<HTMLElement>("pre").forEach((block) => {
			if (block.querySelector("[data-code-copy]")) return;
			const button = document.createElement("button");
			button.type = "button"; button.className = "code-copy"; button.dataset.codeCopy = "true"; button.textContent = "Copy"; button.setAttribute("aria-label", "Copy code");
			button.addEventListener("click", () => copyText(block.textContent ?? "", button)); block.append(button);
		});
		document.querySelectorAll<HTMLButtonElement>("[data-command-copy]").forEach((button) => button.addEventListener("click", () => {
			const command = button.closest(".mdx-command")?.querySelector("code")?.textContent ?? ""; void copyText(command, button);
		}));
		document.querySelectorAll<HTMLButtonElement>("[data-copy-page]").forEach((button) => button.addEventListener("click", async () => {
			const response = await fetch(button.dataset.copyPage ?? ""); if (response.ok) await copyText(await response.text(), button);
		}));
	</script>
</BaseLayout>
