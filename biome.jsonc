{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"files": {
		"includes": [
			"**",
			"!!**/.memoize",
			"!!**/.reference",
			"!!**/.zuse",
			"!!**/.dev-instances",
			"!!**/.turbo",
			"!!**/coverage",
			"!!**/dist",
			"!!**/dist-electron",
			"!!**/node_modules"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["apps/mobile/global.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"noDuplicateCustomProperties": "off"
	}
}
			}
		}
	]
}
