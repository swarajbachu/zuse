{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"files": {
		"includes": [
			"**",
			"!!**/.memoize",
			"!!**/.reference",
			"!!**/.zuse",
			"!!**/.dev-instances",
			"!!**/.turbo",
			"!!**/coverage",
			"!!**/dist",
			"!!**/dist-electron",
			"!!**/node_modules",
			"!!packages/executor-v2/vendor/runtime.mjs"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["apps/web/public/schemas/*.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2,
				"expand": "always"
			}
		},
		{
			"includes": ["apps/mobile/global.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"noDuplicateCustomProperties": "off"
					}
				}
			}
		},
		{
			"includes": [
				"apps/renderer/src/terminal/ghostty/vendor/provenance.json",
				"apps/mobile/modules/mobile-terminal/Vendor/GhosttyVt.provenance.json",
				"apps/mobile/modules/mobile-terminal/android/vendor/manifest.json"
			],
			"formatter": {
				"expand": "always"
			}
		}
	]
}
