#cloud-config
users:
  - name: zuse
    gecos: Zuse runtime
    shell: /bin/bash
    lock_passwd: true
    sudo: false

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - git
  - gnupg
  - jq
  - nftables
  - openssh-server
  - tmux

write_files:
  - path: /var/lib/zuse/enrollment.env
    owner: zuse:zuse
    permissions: "0600"
    content: |
      ZUSE_MACHINE_ID=__MACHINE_ID__
      ZUSE_MACHINE_LABEL=__MACHINE_LABEL__
      ZUSE_RELAY_URL=__RELAY_URL__
      ZUSE_RELAY_ISSUER=__RELAY_ISSUER__
      ZUSE_ENROLLMENT_TOKEN=__ENROLLMENT_TOKEN__
      ZUSE_ENROLLMENT_TOKEN_FILE=/var/lib/zuse/enrollment.env

  - path: /etc/zuse/runtime.env
    owner: root:root
    permissions: "0600"
    content: |
      ZUSE_RUNTIME_MANIFEST_URL=__RUNTIME_MANIFEST_URL__
      ZUSE_MACHINE_RUNTIME_ROLE=cloud-environment

  - path: /etc/zuse/runtime-signing-public.jwk
    owner: root:root
    permissions: "0644"
    content: |
      __RUNTIME_SIGNING_PUBLIC_JWK__

  - path: /etc/ssh/sshd_config.d/90-zuse.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      AllowUsers zuse

  - path: /etc/nftables.conf
    owner: root:root
    permissions: "0644"
    content: |
      #!/usr/sbin/nft -f
      flush ruleset
      table inet filter {
        chain input {
          type filter hook input priority 0; policy drop;
          iifname "lo" accept
          ct state established,related accept
          ip protocol icmp accept
          ip6 nexthdr ipv6-icmp accept
          iifname "tailscale0" tcp dport { 22, 47837 } accept
        }
        chain forward { type filter hook forward priority 0; policy drop; }
        chain output { type filter hook output priority 0; policy accept; }
      }

  - path: /etc/systemd/system/zuse.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Zuse cloud environment
      Wants=network-online.target tailscaled.service
      After=network-online.target tailscaled.service

      [Service]
      Type=simple
      User=zuse
      Group=zuse
      EnvironmentFile=/etc/zuse/runtime.env
      EnvironmentFile=-/var/lib/zuse/enrollment.env
      Environment=ZUSE_HOST=0.0.0.0
      Environment=ZUSE_PORT=47837
      Environment=ZUSE_AUTH_POLICY=protected
      Environment=ZUSE_ENABLE_PAIRING=0
      Environment=ZUSE_USER_DATA=/var/lib/zuse
      ExecStart=/usr/bin/node /opt/zuse/current/bin.mjs serve
      Restart=always
      RestartSec=5
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectSystem=strict
      ProtectHome=read-only
      ReadWritePaths=/var/lib/zuse /home/zuse

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/zuse-update.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Update the Zuse cloud runtime
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      EnvironmentFile=/etc/zuse/runtime.env
      Environment=ZUSE_RUNTIME_PUBLIC_KEY_FILE=/etc/zuse/runtime-signing-public.jwk
      ExecStart=/usr/bin/node /opt/zuse/current/runtime-updater.mjs

  - path: /etc/systemd/system/zuse-update.timer
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Daily Zuse cloud runtime update

      [Timer]
      OnCalendar=daily
      RandomizedDelaySec=2h
      Persistent=true

      [Install]
      WantedBy=timers.target

runcmd:
  - [sh, -c, "curl -fsSL https://deb.nodesource.com/setup_22.x | bash -"]
  - [apt-get, install, -y, nodejs]
  - [sh, -c, "curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | gpg --dearmor -o /usr/share/keyrings/cloudflare-main.gpg"]
  - [sh, -c, "echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' > /etc/apt/sources.list.d/cloudflared.list"]
  - [apt-get, update]
  - [apt-get, install, -y, cloudflared]
  - [sh, -c, "curl -fsSL https://tailscale.com/install.sh | sh"]
  - [tailscale, set, --operator=zuse]
  - [npm, install, -g, "@anthropic-ai/claude-code"]
  - [mkdir, -p, /opt/zuse/releases, /var/lib/zuse, /home/zuse/.ssh]
  - [chown, -R, "zuse:zuse", /var/lib/zuse, /home/zuse]
  - [chmod, "0700", /home/zuse/.ssh]
  - [touch, /home/zuse/.ssh/authorized_keys]
  - [chown, "zuse:zuse", /home/zuse/.ssh/authorized_keys]
  - [chmod, "0600", /home/zuse/.ssh/authorized_keys]
  - [nft, -f, /etc/nftables.conf]
  - [systemctl, enable, --now, nftables]
  - [systemctl, restart, ssh]
  - [sh, -c, "__INSTALL_VERIFIED_RUNTIME_COMMAND__"]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, zuse.service]
  - [systemctl, enable, --now, zuse-update.timer]

final_message: "Zuse cloud bootstrap finished"
