{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zuse-relay-staging",
	"main": "src/worker.ts",
	"minify": true,
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": { "enabled": true },

	"placement": { "region": "aws:ap-northeast-2" },
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.yaml.tmpl",
				"**/runtime-updater.mjs",
				"**/project-builder.sh",
				"**/install-grok.sh",
				"**/workspace-bootstrap.sh",
				"**/workspace-runtime.sh",
				"**/workspace-archive.sh",
				"**/github-auth.sh",
				"**/workspace-repository.sh",
				"**/workspace-fork-prepare.sh",
				"**/snapshot-inspect.sh"
			],
			"fallthrough": true
		}
	],
	"routes": [
		{ "pattern": "api-staging.zuse.sh", "custom_domain": true },
		{ "pattern": "api-staging.stuff.md", "custom_domain": true }
	],
	"triggers": { "crons": ["* * * * *"] },
	"queues": {
		"producers": [
			{ "binding": "SLACK_JOBS", "queue": "zuse-slack-staging-jobs" }
		],
		"consumers": [
			{
				"queue": "zuse-slack-staging-jobs",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_concurrency": 1,
				"max_retries": 5,
				"dead_letter_queue": "zuse-slack-staging-failed"
			}
		]
	},
	"vars": {
		"CLOUD_AUTH_EXECUTOR_LOCATION_HINT": "apac-ne",

		"ORGANIZATION_WORKSPACES_ENABLED": "true",
		"PLUGIN_APP_ORIGIN": "https://code-staging.zuse.sh",

		"SLACK_ENABLED": "true",
		"SLACK_APP_ID": "A0C28PUEJNL",
		"SLACK_CLIENT_ID": "12048365003570.12076810494768",
		"SLACK_PUBLIC_ORIGIN": "https://api-staging.zuse.sh",
		"CLOUD_COMMAND_MAILBOX_ENABLED": "true",
		"CLOUD_CODEX_AUTH_BROKER_ENROLLMENT_ENABLED": "true",
		"CLOUD_CODEX_AUTH_BROKER_SERVING_ENABLED": "true",
		"CLOUD_PROVIDER_AUTH_BROKER_ENROLLMENT_ENABLED": "true",
		"CLOUD_PROVIDER_AUTH_BROKER_SERVING_ENABLED": "true",

		"API_ISSUER": "https://api-staging.stuff.md",
		"API_PUBLIC_ORIGIN": "https://api-staging.zuse.sh",
		"WORKOS_ISSUER": "https://api.workos.com",
		"WORKOS_JWKS_URL": "https://api.workos.com/sso/jwks/client_01KW6ZEZKVMZ0G429A89XZD83Q",
		"API_MINT_PUBLIC_JWK": "{\"crv\":\"Ed25519\",\"x\":\"rLuckqLkdtwPKtradClTam6ovMItDJZ3SNbBQXFjJWw\",\"kty\":\"OKP\"}",
		"MAX_ENVIRONMENTS_PER_ACCOUNT": "5",
		"ALLOWED_BROWSER_ORIGINS": "https://code.zuse.sh,https://code-staging.zuse.sh",
		"GITHUB_APP_ID": "5150694",
		"GITHUB_APP_SLUG": "zuse-staging",
		"GITHUB_APP_CLIENT_ID": "Iv23lim6UymqlW3Tw2HE",

		"MANAGED_TUNNEL_BASE_DOMAIN": "stuff.md",
		"MANAGED_TUNNEL_NAMESPACE": "zenv-staging",
		"CF_ACCOUNT_ID": "40dd16663d44dc635537be6d183af841",
		"CF_ZONE_ID": "1ebb00c5fd61050e9f48ce1c791a29da",

		"MACHINE_ALPHA_ALLOWLIST": "user_01KW7R9WGJFFSKDNESE7RN00N1,user_01M0HA239JJ7P73AA1X5M8KDHF",
		"MACHINE_MANUAL_ENTITLEMENTS": "true",
		"MACHINE_LIVE_CHECKOUT_ENABLED": "true",

		"MACHINE_PROVIDER": "hetzner",
		"HETZNER_ADAPTER_ENABLED": "true",
		"HETZNER_API_BASE_URL": "https://api.hetzner.cloud/v1",
		"HETZNER_FIREWALL_ID": "11418954",
		"HETZNER_IMAGE": "ubuntu-24.04",
		"HETZNER_LOCATION": "nbg1",
		"HETZNER_SERVER_TYPE_PERSISTENT_STANDARD_V1": "cx33",
		"MACHINE_RUNTIME_MANIFEST_URL": "https://github.com/swarajbachu/zuse/releases/download/cloud-runtime-staging/stable-manifest.json",
		"MACHINE_RUNTIME_SIGNING_PUBLIC_JWK": "{\"crv\":\"Ed25519\",\"x\":\"ODy1bBgW390GBMxIqn8wy2eO3C05kXdoPYk5JV09OZI\",\"kty\":\"OKP\"}",
		"CLOUD_WORKSPACE_RUNTIME_MANIFEST_URL": "https://github.com/swarajbachu/zuse/releases/download/cloud-runtime-staging/stable-manifest.json",
		"CLOUD_WORKSPACE_RUNTIME_SIGNING_PUBLIC_JWK": "{\"crv\":\"Ed25519\",\"x\":\"ODy1bBgW390GBMxIqn8wy2eO3C05kXdoPYk5JV09OZI\",\"kty\":\"OKP\"}",
		// Published Zuse image verified with the staging Daytona organization.
		// See internal-docs/cloud/daytona.md.
		"DAYTONA_ADAPTER_ENABLED": "true",
		"DAYTONA_TEMPLATE_ID": "1fc5f01c-8e00-4490-b8c4-228b86a424c5",
		"DAYTONA_TEMPLATE_VERSION": "20261012-1",
		"DAYTONA_VCPU_COUNT": "2",
		"DAYTONA_MEMORY_MIB": "4096",
		"E2B_ADAPTER_ENABLED": "true",
		"BOAT_ADAPTER_ENABLED": "true",
		"BOAT_TEMPLATE_SNAPSHOT": "zuse-base-v8",
		"BOAT_TEMPLATE_VERSION": "8",
		"BOAT_MACHINE_TYPE": "small",
		"SANDBOX_DEFAULT_PROVIDER_ID": "box",

		"BOXD_ADAPTER_ENABLED": "true",
		"CLOUD_BOXD_CUSTOM_SNAPSHOTS_ENABLED": "true",
		"BOXD_BILLING_ENABLED": "true",
		"BOXD_BILLING_CUTOVER_AT": "2026-10-06T17:15:42Z",
		"BOXD_TEMPLATE_SNAPSHOT": "zuse-base-v20260927-1",
		"BOXD_TEMPLATE_VERSION": "20260927-1",
		"BOXD_MACHINE_SIZE": "default",
		"BOXD_ORG": "zuse",
		"E2B_TEMPLATE_ID": "ioeu6w9tn6l30781rikc",
		"E2B_TEMPLATE_VERSION": "d5520ad2-383a-459d-bf39-9441f053bdcb",
		"E2B_VCPU_COUNT": "2",
		"E2B_MEMORY_MIB": "4096",
		"CLOUD_BILLING_ENFORCEMENT_ENABLED": "false",
		"CLOUD_BILLING_EXPORT_ENABLED": "false",
		"CLOUD_USAGE_EXPORT_ENABLED": "true",
		"CLOUD_BILLING_CUTOVER_AT": "",
		"CLOUD_WORKSPACE_IDLE_TIMEOUT_MS": "600000",
		"CLOUD_REPOSITORY_CACHE_MAX_BYTES": "8589934592",

		"BILLING_DEFAULT_PROVIDER": "polar",
		"STRIPE_ENVIRONMENT": "sandbox",
		"STRIPE_PRICE_CLOUD_WORKSPACE_STANDARD_V1": "",
		"STRIPE_PRICE_PERSISTENT_STANDARD_V1": "",
		"STRIPE_CLOUD_OVERAGE_PRICE_ID": "",
		"STRIPE_CLOUD_OVERAGE_METER_ID": "",
		"POLAR_ENVIRONMENT": "sandbox",
		"POLAR_PRODUCT_PERSISTENT_STANDARD_V1": "810223ea-94f2-47e7-9c09-af9a0fd86174",
		"POLAR_PRODUCT_CLOUD_WORKSPACE_STANDARD_V1": "31616352-13b0-48dd-a9cd-11724f358199",
		"POLAR_CLOUD_OVERAGE_METER_ID": "c74994e7-b555-4715-a34a-9dd54a006539",
		"POLAR_VPS_SALES_APPROVED": "false"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "dfc67e0586ff4c288cb645ed63c65d9a"
		}
	],
	"r2_buckets": [
		{
			"binding": "CLOUD_TRANSCRIPTS",
			"bucket_name": "zuse-cloud-transcripts-staging"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "DEVICE_BRIDGE_GATEWAY", "class_name": "DeviceBridgeGateway" },
			{ "name": "PLUGIN_VAULT", "class_name": "PluginVault" },
			{ "name": "CLOUD_AUTH_EXECUTOR", "class_name": "CloudAuthExecutor" },
			{ "name": "WORKSPACE_STARTUP", "class_name": "WorkspaceStartup" },
			{
				"name": "WORKSPACE_GATEWAY",
				"class_name": "WorkspaceGateway"
			},
			{
				"name": "WORKSPACE_MAILBOX",
				"class_name": "WorkspaceMailbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-workspace-gateway",
			"new_sqlite_classes": ["WorkspaceGateway"]
		},
		{
			"tag": "v2-workspace-mailbox",
			"new_sqlite_classes": ["WorkspaceMailbox"]
		},
		{
			"tag": "v3-workspace-startup",
			"new_sqlite_classes": ["WorkspaceStartup"]
		},
		{ "tag": "plugins-v1", "new_sqlite_classes": ["PluginVault"] },
		{
			"tag": "cloud-auth-executor-v1",
			"new_sqlite_classes": ["CloudAuthExecutor"]
		},
		{ "tag": "device-bridge-v1", "new_sqlite_classes": ["DeviceBridgeGateway"] }
	]
}
