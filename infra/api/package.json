{
	"name": "@zuse/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check-types": "tsc --noEmit",
		"test": "vitest run test",
		"test:unit": "vitest run test/unit",
		"test:integration": "vitest run test/integration",
		"mint-keys": "node scripts/mint-keys.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate-database.mjs staging",
		"db:migrate:staging": "node scripts/migrate-database.mjs staging",
		"db:migrate:production": "node scripts/migrate-database.mjs production",
		"cloud-billing:ops": "node scripts/cloud-billing-ops.mjs",
		"secret": "wrangler secret put RELAY_MINT_PRIVATE_JWK --env=",
		"secret:workos": "wrangler secret put WORKOS_API_KEY --env=",
		"secret:cf": "wrangler secret put CF_API_TOKEN --env=",
		"secret:polar": "wrangler secret put POLAR_ACCESS_TOKEN --env=",
		"secret:polar-webhook": "wrangler secret put POLAR_WEBHOOK_SECRET --env=",
		"secret:posthog:production": "wrangler secret put POSTHOG_PROJECT_TOKEN --config wrangler.production.jsonc",
		"secret:hetzner": "wrangler secret put HETZNER_API_TOKEN --env=",
		"secret:e2b": "wrangler secret put E2B_API_KEY --env=",
		"secret:e2b-webhook": "wrangler secret put E2B_WEBHOOK_SECRET --env=",
		"secret:cloud-data": "wrangler secret put CLOUD_DATA_ENCRYPTION_KEY --env=",
		"secret:github-app-id": "wrangler secret put GITHUB_APP_ID --env=",
		"secret:github-app-slug": "wrangler secret put GITHUB_APP_SLUG --env=",
		"secret:github-client-id": "wrangler secret put GITHUB_APP_CLIENT_ID --env=",
		"secret:github-private-key": "wrangler secret put GITHUB_APP_PRIVATE_KEY --env=",
		"secret:github-client-secret": "wrangler secret put GITHUB_APP_CLIENT_SECRET --env=",
		"secret:github-webhook-secret": "wrangler secret put GITHUB_APP_WEBHOOK_SECRET --env=",
		"secret:mint:production": "wrangler secret put RELAY_MINT_PRIVATE_JWK --config wrangler.production.jsonc",
		"secret:workos:production": "wrangler secret put WORKOS_API_KEY --config wrangler.production.jsonc",
		"secret:cf:production": "wrangler secret put CF_API_TOKEN --config wrangler.production.jsonc",
		"secret:e2b:production": "wrangler secret put E2B_API_KEY --config wrangler.production.jsonc",
		"secret:e2b-webhook:production": "wrangler secret put E2B_WEBHOOK_SECRET --config wrangler.production.jsonc",
		"secret:cloud-data:production": "wrangler secret put CLOUD_DATA_ENCRYPTION_KEY --config wrangler.production.jsonc",
		"secret:github-private-key:production": "wrangler secret put GITHUB_APP_PRIVATE_KEY --config wrangler.production.jsonc",
		"secret:github-client-secret:production": "wrangler secret put GITHUB_APP_CLIENT_SECRET --config wrangler.production.jsonc",
		"secret:github-webhook-secret:production": "wrangler secret put GITHUB_APP_WEBHOOK_SECRET --config wrangler.production.jsonc",
		"secret:polar:production": "wrangler secret put POLAR_ACCESS_TOKEN --config wrangler.production.jsonc",
		"secret:polar-webhook:production": "wrangler secret put POLAR_WEBHOOK_SECRET --config wrangler.production.jsonc",
		"dev": "wrangler dev --env=",
		"deploy": "wrangler deploy --env=",
		"deploy:staging": "wrangler deploy --env=",
		"deploy:production": "node scripts/deploy-production.mjs"
	},
	"dependencies": {
		"@zuse/analytics": "*",
		"@zuse/billing-providers": "*",
		"@zuse/contracts": "*",
		"@zuse/machine-providers": "*",
		"@zuse/pokemon-data": "*",
		"@zuse/sandbox-providers": "*",
		"@zuse/utils": "*",
		"@effect/sql-pg": "catalog:",
		"effect": "catalog:",
		"jose": "^6.2.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260601.1",
		"@repo/typescript-config": "*",
		"@types/node": "catalog:",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.4",
		"drizzle-orm": "^0.44.3",
		"jsonc-parser": "^3.3.1",
		"pg": "^8.22.0",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.107.0"
	}
}
