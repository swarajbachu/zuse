{
	// Isolated production configuration. Ordinary relay commands never read this
	// file; only scripts/deploy-production.mjs may select it after confirmation.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zuse-relay",
	"main": "src/worker.ts",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.yaml.tmpl", "**/runtime-updater.mjs"],
			"fallthrough": true
		}
	],
	"routes": [{ "pattern": "relay.stuff.md", "custom_domain": true }],
	"triggers": { "crons": ["* * * * *"] },
	"vars": {
		"RELAY_ISSUER": "https://relay.stuff.md",
		"WORKOS_ISSUER": "https://api.workos.com",
		"WORKOS_JWKS_URL": "https://api.workos.com/sso/jwks/client_01KWGQ818571ARFATQ3G9AR2Y2",
		"RELAY_MINT_PUBLIC_JWK": "{\"crv\":\"Ed25519\",\"x\":\"A2Ig1XwHKDznhyTbPD9IVTlJpaN4YImgQadx-Gl81Bs\",\"kty\":\"OKP\"}",
		"MAX_ENVIRONMENTS_PER_ACCOUNT": "5",
		"ALLOWED_BROWSER_ORIGINS": "https://code.zuse.sh",

		"MANAGED_TUNNEL_BASE_DOMAIN": "stuff.md",
		"MANAGED_TUNNEL_NAMESPACE": "zenv",
		"CF_ACCOUNT_ID": "40dd16663d44dc635537be6d183af841",
		"CF_ZONE_ID": "1ebb00c5fd61050e9f48ce1c791a29da",

		"MACHINE_ALPHA_ALLOWLIST": "",
		"MACHINE_MANUAL_ENTITLEMENTS": "false",
		"MACHINE_LIVE_CHECKOUT_ENABLED": "false",
		"MACHINE_PROVIDER": "fake",
		"HETZNER_ADAPTER_ENABLED": "false",
		"HETZNER_API_BASE_URL": "https://api.hetzner.cloud/v1",
		"HETZNER_FIREWALL_ID": "",
		"HETZNER_IMAGE": "",
		"HETZNER_LOCATION": "",
		"HETZNER_SERVER_TYPE_PERSISTENT_STANDARD_V1": "",
		"MACHINE_RUNTIME_MANIFEST_URL": "",
		"MACHINE_RUNTIME_SIGNING_PUBLIC_JWK": "",
		"E2B_ADAPTER_ENABLED": "false",
		"E2B_TEMPLATE_ID": "",

		"POLAR_ENVIRONMENT": "sandbox",
		"POLAR_PRODUCT_PERSISTENT_STANDARD_V1": "",
		"POLAR_PRODUCT_CLOUD_WORKSPACE_STANDARD_V1": "",
		"POLAR_VPS_SALES_APPROVED": "false"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "c49c02e939494a958fb5fe6805e7b0f2"
		}
	]
}
