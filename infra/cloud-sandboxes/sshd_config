# Used exclusively in single-connection mode (`sshd -i`) by the workspace
# runtime's WebSocket SSH bridge. There is no listening SSH daemon; reachability
# is gated by the relay-issued bridge ticket before sshd ever runs.
HostKey /home/zuse/.ssh/host_ed25519_key
AuthorizedKeysFile /home/zuse/.ssh/authorized_keys
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
AllowUsers zuse
UsePAM no
# The bridge ticket and public-key auth are the perimeter; skip home-directory
# permission checks so runtime-written authorized_keys can never lock users out.
StrictModes no
PidFile none
Subsystem sftp internal-sftp
