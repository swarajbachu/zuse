# Re-exposes the workspace runtime port on the box's stable public HTTPS URL
# after ordinary boots. The adapter registers ports during endpoint resolution
# after snapshot restore. Hosted-port registrations do not carry over into boxes
# created from a snapshot, so the template re-hosts on each start. The URL is
# public because the runtime authenticates its own traffic (ticket-gated SSH
# and gateway routes), matching the E2B public-proxy posture.
[Unit]
Description=Zuse hosted workspace port
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'for attempt in $(seq 1 30); do /home/user/.ascii/host 47837 --public && exit 0; sleep 2; done; exit 1'

[Install]
WantedBy=multi-user.target
