# Applies the quarantined egress policy before the network comes up and
# before any zuse process can run on an ordinary boot. Box snapshot files are
# restored after boot targets have passed, so the adapter also starts this gate
# explicitly before handoff on create, fork, and resume (ADR 0035).
[Unit]
Description=Zuse sandbox egress quarantine
DefaultDependencies=no
Before=network-online.target network.target
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/zuse-firewall boot

[Install]
WantedBy=sysinit.target
