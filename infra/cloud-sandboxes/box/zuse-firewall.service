[Unit]
Description=Zuse sandbox explicit egress quarantine
ConditionPathExists=!/var/lib/zuse-firewall/open-workspace
DefaultDependencies=no
Before=network-online.target network.target
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/zuse-firewall boot

[Install]
WantedBy=sysinit.target
