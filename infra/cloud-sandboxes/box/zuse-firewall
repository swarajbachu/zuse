#!/usr/bin/env bash
# In-guest egress policy for Box sandboxes (ADR 0035). Box exposes no
# host-level network API, so this root-only script is the enforcement point:
# the systemd unit applies quarantine only when open-workspace is absent.
# Ordinary workspaces skip that boot job; setNetwork rewrites the complete
# policy in a single call through the provider command channel.
#
# The barrier scopes to the zuse uid: untrusted code only ever runs as zuse
# (no sudo), while the Box control-plane agent and root stay unrestricted so
# the command channel that lifts the quarantine keeps working.
#
# Usage:
#   zuse-firewall boot                 apply the quarantined policy (boot unit)
#   zuse-firewall apply <base64-json>  apply {"kind":"quarantined"|"open"} or
#                                      {"kind":"restricted","allowOut":[...],"denyOut":[...]}
#   zuse-firewall verify-quarantined   exit 0 iff the quarantined ruleset is live
set -euo pipefail

POLICY_STATE_DIR=/run/zuse-firewall
POLICY_STATE_FILE="$POLICY_STATE_DIR/policy.kind"
PERSISTED_STATE_DIR=/var/lib/zuse-firewall
PERSISTED_POLICY_FILE="$PERSISTED_STATE_DIR/policy.b64"
TABLE=zuse-egress

zuse_uid() {
	id -u zuse
}

ruleset_quarantined() {
	local uid
	uid="$(zuse_uid)"
	cat <<EOF
table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
	chain output {
		type filter hook output priority 0; policy accept;
		oifname "lo" accept
		meta skuid $uid drop
	}
}
EOF
}

ruleset_open() {
	cat <<EOF
table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
	chain output {
		type filter hook output priority 0; policy accept;
	}
}
EOF
}

# Resolve hostnames as root at policy-application time. Restricted mode is
# an IP allowlist, not a domain-filtering DNS proxy. No external DNS bypass
# is granted: use preconfigured local resolution or literal IP addresses.
address_rules() {
	local uid="$1" action="$2" entries="$3" entry address family resolved
	while IFS= read -r entry; do
		[ -n "$entry" ] || continue
		if [[ "$entry" =~ ^[0-9a-fA-F.:]+(/[0-9]+)?$ ]]; then
			resolved="$entry"
		else
			[[ "$entry" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]] || return 1
			resolved="$(getent ahosts "$entry" | awk '{print $1}' | sort -u)"
			[ -n "$resolved" ] || return 1
		fi
		while IFS= read -r address; do
			[ -n "$address" ] || continue
			family=ip
			[[ "$address" == *:* ]] && family=ip6
			printf '\t\tmeta skuid %s %s daddr %s %s\n' "$uid" "$family" "$address" "$action"
		done <<<"$resolved"
	done <<<"$entries"
}

ruleset_restricted() {
	local uid allow_specs deny_specs
	uid="$(zuse_uid)"
	allow_specs="$(address_rules "$uid" accept "$1")" || return 1
	deny_specs="$(address_rules "$uid" drop "${2:-}")" || return 1
	cat <<EOF
table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
	chain output {
		type filter hook output priority 0; policy accept;
		meta skuid != $uid accept
$deny_specs
		oifname "lo" accept
$allow_specs
		meta skuid $uid drop
	}
}
EOF
}

apply_policy() {
	local payload kind persist="${2:-true}"
	payload="$(printf '%s' "$1" | base64 -d)"
	kind="$(printf '%s' "$payload" | jq -r '.kind')"
	mkdir -p "$POLICY_STATE_DIR"
	chmod 700 "$POLICY_STATE_DIR"
	case "$kind" in
	quarantined)
		ruleset_quarantined | nft -f -
		;;
	open)
		ruleset_open | nft -f -
		;;
	restricted)
		ruleset_restricted "$(printf '%s' "$payload" | jq -r '.allowOut[]?')" "$(printf '%s' "$payload" | jq -r '.denyOut[]?')" | nft -f -
		;;
	*)
		echo "unknown policy kind: $kind" >&2
		exit 1
		;;
	esac
	printf '%s' "$kind" >"$POLICY_STATE_FILE"
	if [ "$persist" = "true" ]; then
		mkdir -p "$PERSISTED_STATE_DIR"
		chmod 700 "$PERSISTED_STATE_DIR"
		printf '%s' "$1" >"$PERSISTED_POLICY_FILE"
		chmod 600 "$PERSISTED_POLICY_FILE"
	fi
}

verify_quarantined() {
	[ "$(cat "$POLICY_STATE_FILE" 2>/dev/null)" = "quarantined" ] || exit 1
	nft list table inet "$TABLE" | grep -q "meta skuid $(zuse_uid) drop" || exit 1
}

case "${1:-}" in
boot)
	# Always begin fail-closed. The adapter restores the last requested policy
	# only after Box is usable and before handing the sandbox to untrusted code.
	apply_policy "$(printf '{"kind":"quarantined"}' | base64 -w0)" false
	;;
apply)
	apply_policy "${2:?missing policy argument}"
	;;
restore)
	if [ -s "$PERSISTED_POLICY_FILE" ]; then
		apply_policy "$(cat "$PERSISTED_POLICY_FILE")" false
	else
		apply_policy "$(printf '{"kind":"quarantined"}' | base64 -w0)" false
	fi
	;;
verify-quarantined)
	verify_quarantined
	;;
*)
	echo "usage: zuse-firewall boot|apply <base64-json>|restore|verify-quarantined" >&2
	exit 1
	;;
esac
