{
	"name": "@zuse/sandbox-providers",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		},
		"./e2b": {
			"types": "./src/e2b.ts",
			"import": "./src/e2b.ts",
			"require": "./src/e2b.ts"
		},
		"./testing": {
			"types": "./src/testing.ts",
			"import": "./src/testing.ts",
			"require": "./src/testing.ts"
		}
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"test": "vitest run test/unit",
		"test:live": "vitest run test/live",
		"test:unit": "vitest run test/unit --passWithNoTests"
	},
	"dependencies": {
		"@zuse/provider-registry": "*",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@repo/typescript-config": "*",
		"@types/node": "catalog:",
