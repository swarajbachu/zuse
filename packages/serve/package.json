{
	"name": "@zusehq/serve",
	"version": "0.1.6",
	"description": "One-command remote access for Zuse workspaces",
	"license": "AGPL-3.0-only",
	"type": "module",
	"bin": {
		"zuse": "dist/bin.mjs"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./cli": {
			"types": "./src/cli-types.ts",
			"import": "./dist/cli.mjs"
		},
		"./status": {
			"types": "./src/status-types.ts",
			"import": "./dist/status.mjs"
		}
	},
	"files": [
		"dist",
		"src/cli-types.ts",
		"src/status-types.ts"
	],
	"scripts": {
		"build": "tsdown --config tsdown.config.ts",
		"check-types": "tsc --noEmit",
		"test": "vitest run test"
	},
	"dependencies": {
		"@zusehq/server": "0.1.3"
	},
	"devDependencies": {
		"@zuse/client-runtime": "*",
		"@repo/typescript-config": "*",
		"@types/node": "catalog:",
		"@zuse/contracts": "*",
		"@zuse/utils": "*",
		"effect": "4.0.0-beta.102",
		"tsdown": "0.21.10",
		"typescript": "catalog:",
		"vitest": "4.1.10",
		"vite-plus": "0.2.5"
	}
}
