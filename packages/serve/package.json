{
	"name": "@zusehq/serve",
	"version": "0.1.1",
	"description": "One-command remote access for Zuse workspaces",
	"license": "MIT",
	"type": "module",
	"bin": {
		"zuse": "dist/bin.mjs"
	},
	"engines": {
		"node": ">=22.5.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./cli": {
			"types": "./src/cli-types.ts",
			"import": "./dist/cli.mjs"
		},
		"./status": {
			"types": "./src/status-types.ts",
			"import": "./dist/status.mjs"
		}
	},
	"files": [
		"dist",
		"src/cli-types.ts",
		"src/status-types.ts"
	],
	"scripts": {
		"build": "vp pack src/bin.ts src/cli.ts src/status.ts",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@zusehq/server": "0.1.1",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@repo/typescript-config": "*",
		"@types/node": "catalog:",
		"@zuse/contracts": "*",
		"tsdown": "0.21.10",
		"typescript": "catalog:",
		"vite-plus": "0.2.5"
	}
}
